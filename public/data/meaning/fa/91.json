[["سوگند به خورشید","و تابش آن"],["سوگند به ماه","هنگامي كه","از پی آن آمد"],["و سوگند به روز","هنگامي كه","ظاهر کرد آن را"],["و سوگند به شب","هنگامي كه","می پوشاند آن را"],["سوگند به آسمان","و آن که","بنا کرد آن را"],["و زمين","و آن که","گستراند آن را"],["و سوگند به نفس","و آن که","ساخت و پرداخت آن را"],["پس الهام کرد به او","گناهکاریش","و حق گراییش"],["البته","رستگار و پیروز شد","کسی که","تزکیه کرد خود را"],["و بی گمان","محروم شد، باخت","کسی که","آلوده کرد آن را"],["تکذیب کرد","ثمود","از روی طغیان و سرکشی"],["آن زمان که","فرستاده شد، بر خاست و حرکت کرد","شقی ترین"],["پس گفت","به آنان","رسول","خداوند","ناقه","خداوند","و آب دادن او، نوبت آب او"],["پس تکذیب کردند او را","پس دست و پایش بریدند","پس هلاک کرد","آنها را","پروردگارشان","به گناهانشان","پس با خاک یکسان کرد آنها را"],["و نه","می ترسد","عاقبت آن"]]